# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
DB_PASSWORD=change-me
JWT_SECRET=change-me

# --- Exposition -------------------------------------------------------------
# Port hôte de l'API (ton reverse proxy pointera ici)
API_PORT=8000
# Interface hôte d'écoute de l'API. 127.0.0.1 = l'API n'est joignable que
# depuis l'hôte (reverse proxy local recommandé). 0.0.0.0 = toutes interfaces,
# à n'exposer que derrière un pare-feu.
API_BIND=127.0.0.1
# Mode TLS intégré : décommente DOMAIN et lance avec --profile caddy
# DOMAIN=tapitask.example.com
# CORS_ORIGINS=https://tapitask.example.com
# Sinon (reverse proxy externe), autorise l'origine de ton proxy :
CORS_ORIGINS=http://localhost:8080

# --- Webapp (optionnelle, --profile web) ------------------------------------
# WEB_PORT=8080

# --- Compte admin par défaut (créé au démarrage si absent) ------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-longpass

# --- Email (invitations, partages de listes) ---
SMTP_ENABLED=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tapitask@example.com

# --- Rate limiting multi-workers (optionnel, Recommande si >1 worker) ---
# REDIS_URL=redis://localhost:6379/0

# --- Proxy de confiance -----------------------------------------------------
# IPs (commas) des reverse proxy derrière lesquels on tourne l'API. Seulement
# alors que le pair direct est l'un de ceux-ci, l'en-tête X-Forwarded-For est
# utilisée pour les clés de rate-limiting/lockout. Laisser vide = on utilise
# l'IP du pair direct (recommandé : empêche un client de rotater un
# X-Forwarded-For forgé pour contourner la limite de tentatives de login).
# TRUSTED_PROXIES=10.0.0.1,172.17.0.1

# --- Webhooks : liste blanche SSRF (optionnel) ------------------------------
# Hostnames (commas, préfixe "." pour les sous-domaines) autorisés à pointer
# vers des adresses privées/loopback. Par défaut les webhooks vers
# loopback/RFC1918/metadata (169.254.169.254) sont bloqués.
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com

# --- Test-only --------------------------------------------------------------
# 1 = environnement explicitement de test : autorise un JWT_SECRET < 32 octets.
# À NE JAMAIS activer en production.
# TEST_ENV=1
